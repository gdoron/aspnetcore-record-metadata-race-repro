<Project Sdk="Microsoft.NET.Sdk">

    <!-- Deliberately self-contained: this project is handed to Microsoft as a standalone repro,
         so it must build after being copied out of this repository on its own. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>AspNetCoreRecordMetadataRaceRepro</AssemblyName>
        <RootNamespace>AspNetCoreRecordMetadataRaceRepro</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);CA1852</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

</Project>
